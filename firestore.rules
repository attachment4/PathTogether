rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isMember(spaceId) {
      let ref = /databases/$(database)/documents/spaces/$(spaceId)/data/members;
      return isAuthed() && (
        !exists(ref) ||
        (exists(ref) && request.auth.uid in get(ref).data.memberIds)
      );
    }

    function isOwner(spaceId) {
      let ref = /databases/$(database)/documents/spaces/$(spaceId)/data/members;
      return isAuthed() && (
        !exists(ref) ||
        (exists(ref) && request.auth.uid in get(ref).data.ownerIds)
      );
    }

    // Пользователь добавляет ТОЛЬКО себя в members (для doJoin)
    // Проверяем: новый массив memberIds содержит uid, старый — нет
    function isJoiningSelf(spaceId) {
      let ref = /databases/$(database)/documents/spaces/$(spaceId)/data/members;
      let uid = request.auth.uid;
      let newIds = request.resource.data.memberIds;
      // uid должен быть в новом списке
      let uidInNew = uid in newIds;
      // uid не должен быть в старом (иначе просто обновление)
      let existingIds = exists(ref) ? get(ref).data.memberIds : [];
      let uidNotInOld = !(uid in existingIds);
      // Размер нового списка = старый + 1 (нельзя добавить больше одного за раз)
      let sizeOk = newIds.size() == existingIds.size() + 1;
      return isAuthed() && uidInNew && uidNotInOld && sizeOk;
    }

    match /users/{uid} {
      allow read, write: if isAuthed() && request.auth.uid == uid;
    }

    match /spaces/{spaceId} {
      // Привычки: только участники пространства
      match /habits/{habitId} {
        allow read:   if isMember(spaceId);
        allow create: if isMember(spaceId);
        allow update: if isMember(spaceId);
        // Удалять привычку может только её владелец или owner пространства
        allow delete: if isAuthed() && (
          isOwner(spaceId) ||
          resource.data.ownerId == request.auth.uid
        );
      }

      match /data/{document} {
        // members читается любым авторизованным пользователем — это нужно для doJoin:
        // присоединяющийся ещё НЕ в списке участников, но должен прочитать текущий
        // состав, чтобы добавить себя. spaceId — случайный id, узнать его можно только
        // через секретный код инвайта, поэтому утечки данных нет.
        // logs и meta остаются доступны только участникам пространства.
        allow read: if isAuthed() && (document == 'members' || isMember(spaceId));
        allow write: if isAuthed() && (
          document == 'members'
            // Создание первого члена (ensureSpace), обновление owner'ом, или join (добавление себя)
            ? (isOwner(spaceId)
               || !exists(/databases/$(database)/documents/spaces/$(spaceId)/data/members)
               || isJoiningSelf(spaceId))
            : isMember(spaceId)
        );
      }

      match /notifications/{notifId} {
        allow create: if isAuthed();
        allow read, update: if isAuthed();
        allow delete: if false;
      }
    }

    match /invites/{code} {
      allow read:   if isAuthed();
      allow create: if isAuthed() &&
                       request.resource.data.creatorId == request.auth.uid;
      allow update: if false;
      allow delete: if isAuthed() && (
                       resource.data.creatorId == request.auth.uid ||
                       isMember(resource.data.spaceId)
                    );
    }

    match /config/{document} {
      allow read: if isAuthed();
      allow write: if false;
    }

    match /config/early_birds {
      allow read:   if isAuthed();
      allow write:  if isAuthed();
    }

    match /subscriptions/{uid} {
      allow read, write: if isAuthed() && request.auth.uid == uid;
    }

    match /payments/{paymentId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

  }
}
