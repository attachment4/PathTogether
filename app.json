{
  "expo": {
    "name": "PathTogether",
    "slug": "pathtogether",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_new.png",
    "scheme": "pathtogether",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0a0a0a"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.attach4.pathtogether",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "fetch",
          "remote-notification",
          "fetch"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_new.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.attach4.pathtogether",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "attachment4.github.io",
              "pathPrefix": "/PathTogether/invite.html"
            },
            {
              "scheme": "https",
              "host": "pathtogether.app",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "pathtogether"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "attachment4.github.io",
              "pathPrefix": "/PathTogether/invite.html"
            },
            {
              "scheme": "https",
              "host": "pathtogether.app",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "pathtogether"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 4,
      "minSdkVersion": 23,
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon_new.png",
          "color": "#0a0a0a",
          "defaultChannel": "partner",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PathTogether to access your photos.",
          "cameraPermission": "Allow PathTogether to access your camera."
        }
      ],
      "@react-native-google-signin/google-signin",
      "./plugins/withRuStore",
      "./plugins/withWidgetPin",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Habits",
              "label": "PathTogether",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Привычки на сегодня",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9eb18cbf-9bd3-49e1-b098-b71b0f717b55"
      },
      "rustore": true
    },
    "owner": "attach",
    "description": "Отслеживай привычки вместе с партнёром",
    "sdkVersion": "54.0.0",
    "newArchEnabled": false,
    "experiments": {
      "baseUrl": "/app"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9eb18cbf-9bd3-49e1-b098-b71b0f717b55"
    }
  }
}
